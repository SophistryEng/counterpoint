{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"rootDir": "./src",
		"strict": true,
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"noUncheckedSideEffectImports": true,
		"isolatedModules": true,
		"skipLibCheck": true
	},
	"include": ["src"]
}
